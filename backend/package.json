    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.8",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.0",
