    "bullmq": "^5.7.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fastest-levenshtein": "^1.0.16",
    "ioredis": "^5.10.1",
